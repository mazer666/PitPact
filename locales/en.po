# data/rooms/hearth.tres
msgid "ROOM_HEARTH_NAME"
msgstr "Hearth"

msgid "ROOM_HEARTH_DESC"
msgstr "A communal fire-pit and gathering space where inhabitants eat, talk, and remember."

# data/resources/*.tres
msgid "RES_STONE_NAME"
msgstr "Stone"

msgid "RES_STONE_DESC"
msgstr "Raw mineral dug from the walls of the realm."

msgid "RES_FUNGI_NAME"
msgstr "Fungi"

msgid "RES_FUNGI_DESC"
msgstr "Farmable mushroom cultures that feed the realm and yield a few medicinal strains."

msgid "RES_EMBER_NAME"
msgstr "Ember"

msgid "RES_EMBER_DESC"
msgstr "A dim warmth drawn from places, events, and beings. Used in rituals and binding."

msgid "RES_MEMORY_NAME"
msgstr "Memory"

msgid "RES_MEMORY_DESC"
msgstr "Stories, recipes, and facts remembered by the inhabitants. Spent to research."

# data/biomes/*.tres
msgid "BIOME_HOLLOW_NAME"
msgstr "The Hollow"

msgid "BIOME_HOLLOW_NARRATIVE"
msgstr "Where the rock first learns to listen."

msgid "BIOME_DUSTMAZE_NAME"
msgstr "Dustmaze"

msgid "BIOME_DUSTMAZE_NARRATIVE"
msgstr "Old roads that no longer agree on where they go."

msgid "BIOME_MARSHLANDS_NAME"
msgstr "Marshlands"

msgid "BIOME_MARSHLANDS_NARRATIVE"
msgstr "Where the ground gives before it bears."

msgid "BIOME_HIGHLANDS_NAME"
msgstr "Highlands"

msgid "BIOME_HIGHLANDS_NARRATIVE"
msgstr "Wind-scoured stone that remembers every step."

# data/origins/*.tres
msgid "ORIGIN_SCHOLAR_NAME"
msgstr "Scholar"

msgid "ORIGIN_SCHOLAR_NARRATIVE"
msgstr "You arrived with a library, a ledger, and a quiet certainty that every contract has a clause you have not read yet."

msgid "ORIGIN_WARDEN_NAME"
msgstr "Warden"

msgid "ORIGIN_WARDEN_NARRATIVE"
msgstr "You arrived with a key-ring, a roster, and a longer list of names you are responsible for than names you trust."

# M0 menu strings
msgid "MENU_NEW_CAMPAIGN"
msgstr "New Campaign"

msgid "MENU_CONTINUE"
msgstr "Continue"

msgid "MENU_QUIT"
msgstr "Quit"

msgid "MENU_RESUME"
msgstr "Resume"

msgid "MENU_SAVE"
msgstr "Save"

msgid "MENU_LOAD"
msgstr "Load"

msgid "MENU_RETURN_TO_TITLE"
msgstr "Return to Title"

msgid "DIAG_TOGGLE"
msgstr "Toggle Diagnostics"

msgid "MINIMAP_TOGGLE"
msgstr "Toggle Minimap"

# M2 Track B — contracts, tasks, crises
msgid "CONTRACT_STANDARD_PACT_NAME"
msgstr "Standard Pact"

msgid "CRISIS_FIRST_INSPECTION_NAME"
msgstr "First Inspection"

msgid "CRISIS_CHOICE_RECEIVE_INSPECTOR"
msgstr "Receive the Inspector"

msgid "CRISIS_CHOICE_RECEIVE_INSPECTOR_SUMMARY"
msgstr "The gates are opened. The inspector enters the realm and watches for three days. No morale penalty is taken."

msgid "CRISIS_CHOICE_EVADE_INSPECTOR"
msgstr "Evade the Inspector"

msgid "CRISIS_CHOICE_EVADE_INSPECTOR_SUMMARY"
msgstr "The gates stay closed. The inspector departs. Every inhabitant's morale takes a small penalty."

msgid "CRISIS_CHOICE_CONFRONT_INSPECTOR"
msgstr "Confront the Inspector"

msgid "CRISIS_CHOICE_CONFRONT_INSPECTOR_SUMMARY"
msgstr "A Lanternbearer steps forward. The inspector's affinity for the realm improves."

msgid "EVENT_CONTRACT_BREACH"
msgstr "Contract {id} has been breached. Consequence: {consequence}."

msgid "EVENT_TASK_COMPLETED"
msgstr "Task {id} has been completed."

msgid "EVENT_CRISIS_TRIGGERED"
msgstr "Crisis {id} has been triggered."

msgid "EVENT_CRISIS_CHOICE_MADE"
msgstr "Crisis {id} resolved by the choice {choice}."

# M3 Track B — narrative anchors, branching events
msgid "ANCHOR_FIRST_MORNING_NAME"
msgstr "First Morning"

msgid "ANCHOR_FIRST_MORNING_SUMMARY"
msgstr "The first morning of the realm; the fire is lit and the inhabitants gather around it."

msgid "ANCHOR_STOWAWAY_NAME"
msgstr "Stowaway"

msgid "ANCHOR_STOWAWAY_SUMMARY"
msgstr "Someone has slipped into the realm unseen. The settlers are uncertain whether to greet them or chase them off."

msgid "ANCHOR_FIRST_PACTMAKER_NAME"
msgstr "First Pactmaker Visit"

msgid "ANCHOR_FIRST_PACTMAKER_SUMMARY"
msgstr "A Pactmaker arrives from beyond the Hollow. They speak of rituals, of binding, of the first true name the realm will be asked to remember."

msgid "ANCHOR_INSPECTOR_RETURNS_NAME"
msgstr "The Inspector Returns"

msgid "ANCHOR_INSPECTOR_RETURNS_SUMMARY"
msgstr "The Inspector returns to the realm, uninvited. The previous counter-offer has not been forgotten."

msgid "BRANCH_ACCEPT_AUDIT"
msgstr "Accept the Audit"

msgid "BRANCH_COUNTER_OFFER"
msgstr "Make a Counter-Offer"

msgid "EVENT_NARRATIVE_ANCHOR_TRIGGERED"
msgstr "Narrative anchor {anchor_id} has been triggered."

msgid "EVENT_NARRATIVE_ANCHOR_RESOLVED"
msgstr "Narrative anchor {anchor_id} has been resolved."

msgid "EVENT_EXPLORATION_REVEALED"
msgstr "An inhabitant explored a new tile; {count} tiles revealed."

