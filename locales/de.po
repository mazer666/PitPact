# M4_CRISIS_PLAGUE_QUARANTINE
msgid "M4_CRISIS_PLAGUE_QUARANTINE"
msgstr "Quarantäne"

# M4_CRISIS_PLAGUE_QUARANTINE_SUMMARY
msgid "M4_CRISIS_PLAGUE_QUARANTINE_SUMMARY"
msgstr "Isoliere die Infizierten. Moral -10, keine Tode."

# M4_CRISIS_PLAGUE_SEEK_PACTMAKER
msgid "M4_CRISIS_PLAGUE_SEEK_PACTMAKER"
msgstr "Paktmacher suchen"

# M4_CRISIS_PLAGUE_SEEK_PACTMAKER_SUMMARY
msgid "M4_CRISIS_PLAGUE_SEEK_PACTMAKER_SUMMARY"
msgstr "Verbrauche eine Paktmacher-Intervention, um den Riss zu versiegeln. Kein Moralverlust."

# M4_CRISIS_PLAGUE_BURN_INFECTED
msgid "M4_CRISIS_PLAGUE_BURN_INFECTED"
msgstr "Infizierte verbrennen"

# M4_CRISIS_PLAGUE_BURN_INFECTED_SUMMARY
msgid "M4_CRISIS_PLAGUE_BURN_INFECTED_SUMMARY"
msgstr "Verbrenne die Infizierten. Moral -20, keine Tode, aber -1 Einwohner."

# M4_CRISIS_FACTION_MEDIATE
msgid "M4_CRISIS_FACTION_MEDIATE"
msgstr "Vermitteln"

# M4_CRISIS_FACTION_MEDIATE_SUMMARY
msgid "M4_CRISIS_FACTION_MEDIATE_SUMMARY"
msgstr "Zwischen den Fraktionen verhandeln. Keine Haltungsänderung."

# M4_CRISIS_FACTION_SIDE_LANTERN
msgid "M4_CRISIS_FACTION_SIDE_LANTERN"
msgstr "Laternen-Clan unterstützen"

# M4_CRISIS_FACTION_SIDE_LANTERN_SUMMARY
msgid "M4_CRISIS_FACTION_SIDE_LANTERN_SUMMARY"
msgstr "Unterstütze den Laternen-Clan. Laternen-Clan +0,2, Buchhalter-Kabal -0,2."

# M4_CRISIS_FACTION_SIDE_LEDGER
msgid "M4_CRISIS_FACTION_SIDE_LEDGER"
msgstr "Buchhalter-Kabal unterstützen"

# M4_CRISIS_FACTION_SIDE_LEDGER_SUMMARY
msgid "M4_CRISIS_FACTION_SIDE_LEDGER_SUMMARY"
msgstr "Unterstütze den Buchhalter-Kabal. Buchhalter-Kabal +0,2, Laternen-Clan -0,2."

