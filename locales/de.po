# data/rooms/hearth.tres
msgid "ROOM_HEARTH_NAME"
msgstr "Heimatfeuer"

msgid "ROOM_HEARTH_DESC"
msgstr "Eine gemeinsame Feuerstelle und ein Treffpunkt, an dem die Bewohner essen, reden und sich erinnern."

# data/resources/*.tres
msgid "RES_STONE_NAME"
msgstr "Stein"

msgid "RES_STONE_DESC"
msgstr "Roher Stein, aus den Wänden des Reiches gebrochen."

msgid "RES_FUNGI_NAME"
msgstr "Pilze"

msgid "RES_FUNGI_DESC"
msgstr "Züchtbare Pilzkulturen, die das Reich ernähren und einige medizinische Stämme liefern."

msgid "RES_EMBER_NAME"
msgstr "Glut"

msgid "RES_EMBER_DESC"
msgstr "Eine schwache Wärme, die von Orten, Ereignissen und Wesen gezogen wird. Wird bei Ritualen und Bindungen verwendet."

msgid "RES_MEMORY_NAME"
msgstr "Erinnerung"

msgid "RES_MEMORY_DESC"
msgstr "Geschichten, Rezepte und Fakten, an die sich die Bewohner erinnern. Wird für die Forschung ausgegeben."

# data/biomes/*.tres
msgid "BIOME_HOLLOW_NAME"
msgstr "Die Hohlung"

msgid "BIOME_HOLLOW_NARRATIVE"
msgstr "Wo der Stein zum ersten Mal lernt zuzuhören."

msgid "BIOME_DUSTMAZE_NAME"
msgstr "Staublabyrinth"

msgid "BIOME_DUSTMAZE_NARRATIVE"
msgstr "Alte Wege, die sich nicht mehr einig sind, wohin sie führen."

# data/origins/*.tres
msgid "ORIGIN_SCHOLAR_NAME"
msgstr "Gelehrter"

msgid "ORIGIN_SCHOLAR_NARRATIVE"
msgstr "Du kamst mit einer Bibliothek, einem Hauptbuch und der stillen Gewissheit, dass jeder Vertrag eine Klausel hat, die du noch nicht gelesen hast."

msgid "ORIGIN_WARDEN_NAME"
msgstr "Hüter"

msgid "ORIGIN_WARDEN_NARRATIVE"
msgstr "Du kamst mit einem Schlüsselbund, einer Liste und einer längeren Liste von Namen, für die du verantwortlich bist, als von Namen, denen du vertraust."

