# data/rooms/hearth.tres
msgid "ROOM_HEARTH_NAME"
msgstr "Heimatfeuer"

msgid "ROOM_HEARTH_DESC"
msgstr "Eine gemeinsame Feuerstelle und ein Treffpunkt, an dem die Bewohner essen, reden und sich erinnern."

# data/resources/*.tres
msgid "RES_STONE_NAME"
msgstr "Stein"

msgid "RES_STONE_DESC"
msgstr "Roher Stein, aus den Wänden des Reiches gebrochen."

msgid "RES_FUNGI_NAME"
msgstr "Pilze"

msgid "RES_FUNGI_DESC"
msgstr "Züchtbare Pilzkulturen, die das Reich ernähren und einige medizinische Stämme liefern."

msgid "RES_EMBER_NAME"
msgstr "Glut"

msgid "RES_EMBER_DESC"
msgstr "Eine schwache Wärme, die von Orten, Ereignissen und Wesen gezogen wird. Wird bei Ritualen und Bindungen verwendet."

msgid "RES_MEMORY_NAME"
msgstr "Erinnerung"

msgid "RES_MEMORY_DESC"
msgstr "Geschichten, Rezepte und Fakten, an die sich die Bewohner erinnern. Wird für die Forschung ausgegeben."

# data/biomes/*.tres
msgid "BIOME_HOLLOW_NAME"
msgstr "Die Hohlung"

msgid "BIOME_HOLLOW_NARRATIVE"
msgstr "Wo der Stein zum ersten Mal lernt zuzuhören."

msgid "BIOME_DUSTMAZE_NAME"
msgstr "Staublabyrinth"

msgid "BIOME_DUSTMAZE_NARRATIVE"
msgstr "Alte Wege, die sich nicht mehr einig sind, wohin sie führen."

msgid "BIOME_MARSHLANDS_NAME"
msgstr "Sumpflande"

msgid "BIOME_MARSHLANDS_NARRATIVE"
msgstr "Wo der Boden nachgibt, bevor er trägt."

msgid "BIOME_HIGHLANDS_NAME"
msgstr "Hochland"

msgid "BIOME_HIGHLANDS_NARRATIVE"
msgstr "Windgepeinigter Stein, der sich an jeden Schritt erinnert."

# data/origins/*.tres
msgid "ORIGIN_SCHOLAR_NAME"
msgstr "Gelehrter"

msgid "ORIGIN_SCHOLAR_NARRATIVE"
msgstr "Du kamst mit einer Bibliothek, einem Hauptbuch und der stillen Gewissheit, dass jeder Vertrag eine Klausel hat, die du noch nicht gelesen hast."

msgid "ORIGIN_WARDEN_NAME"
msgstr "Hüter"

msgid "ORIGIN_WARDEN_NARRATIVE"
msgstr "Du kamst mit einem Schlüsselbund, einer Liste und einer längeren Liste von Namen, für die du verantwortlich bist, als von Namen, denen du vertraust."

# M0 menu strings
msgid "MENU_NEW_CAMPAIGN"
msgstr "Neue Kampagne"

msgid "MENU_CONTINUE"
msgstr "Fortsetzen"

msgid "MENU_QUIT"
msgstr "Beenden"

msgid "MENU_RESUME"
msgstr "Weiterspielen"

msgid "MENU_SAVE"
msgstr "Speichern"

msgid "MENU_LOAD"
msgstr "Laden"

msgid "MENU_RETURN_TO_TITLE"
msgstr "Zurück zum Titel"

msgid "DIAG_TOGGLE"
msgstr "Diagnose umschalten"

msgid "MINIMAP_TOGGLE"
msgstr "Minikarte umschalten"

# M2 Track B — contracts, tasks, crises
msgid "CONTRACT_STANDARD_PACT_NAME"
msgstr "Standardpakt"

msgid "CRISIS_FIRST_INSPECTION_NAME"
msgstr "Erste Inspektion"

msgid "CRISIS_CHOICE_RECEIVE_INSPECTOR"
msgstr "Den Inspektor empfangen"

msgid "CRISIS_CHOICE_RECEIVE_INSPECTOR_SUMMARY"
msgstr "Die Tore werden geöffnet. Der Inspektor betritt das Reich und beobachtet es drei Tage lang. Es wird kein Moralklick verhängt."

msgid "CRISIS_CHOICE_EVADE_INSPECTOR"
msgstr "Dem Inspektor ausweichen"

msgid "CRISIS_CHOICE_EVADE_INSPECTOR_SUMMARY"
msgstr "Die Tore bleiben geschlossen. Der Inspektor reist ab. Jeder Bewohner erleidet eine kleine Moraleinbuße."

msgid "CRISIS_CHOICE_CONFRONT_INSPECTOR"
msgstr "Dem Inspektor entgegentreten"

msgid "CRISIS_CHOICE_CONFRONT_INSPECTOR_SUMMARY"
msgstr "Ein Laternenträger tritt vor. Die Zuneigung des Inspektors zum Reich verbessert sich."

msgid "EVENT_CONTRACT_BREACH"
msgstr "Vertrag {id} wurde gebrochen. Konsequenz: {consequence}."

msgid "EVENT_TASK_COMPLETED"
msgstr "Aufgabe {id} wurde abgeschlossen."

msgid "EVENT_CRISIS_TRIGGERED"
msgstr "Krise {id} wurde ausgelöst."

msgid "EVENT_CRISIS_CHOICE_MADE"
msgstr "Krise {id} durch die Wahl {choice} gelöst."

# M3 Track B — narrative anchors, branching events
msgid "ANCHOR_FIRST_MORNING_NAME"
msgstr "Erster Morgen"

msgid "ANCHOR_FIRST_MORNING_SUMMARY"
msgstr "Der erste Morgen des Reichs; das Feuer brennt und die Bewohner versammeln sich darum."

msgid "ANCHOR_STOWAWAY_NAME"
msgstr "Blinder Passagier"

msgid "ANCHOR_STOWAWAY_SUMMARY"
msgstr "Jemand ist ungesehen ins Reich geschlüpft. Die Siedler sind unsicher, ob sie ihn grüßen oder vertreiben sollen."

msgid "ANCHOR_FIRST_PACTMAKER_NAME"
msgstr "Erster Paktierer-Besuch"

msgid "ANCHOR_FIRST_PACTMAKER_SUMMARY"
msgstr "Ein Paktierer kommt aus der Hohlwelt. Er spricht von Ritualen, vom Binden, vom ersten wahren Namen, an den sich das Reich erinnern soll."

msgid "ANCHOR_INSPECTOR_RETURNS_NAME"
msgstr "Der Inspektor kehrt zurück"

msgid "ANCHOR_INSPECTOR_RETURNS_SUMMARY"
msgstr "Der Inspektor kehrt ungebeten ins Reich zurück. Das frühere Gegenangebot ist nicht vergessen."

msgid "BRANCH_ACCEPT_AUDIT"
msgstr "Die Prüfung akzeptieren"

msgid "BRANCH_COUNTER_OFFER"
msgstr "Ein Gegenangebot machen"

msgid "EVENT_NARRATIVE_ANCHOR_TRIGGERED"
msgstr "Erzählerischer Anker {anchor_id} wurde ausgelöst."

msgid "EVENT_NARRATIVE_ANCHOR_RESOLVED"
msgstr "Erzählerischer Anker {anchor_id} wurde aufgelöst."

msgid "EVENT_EXPLORATION_REVEALED"
msgstr "Ein Bewohner hat eine neue Kachel erkundet; {count} Kacheln aufgedeckt."

