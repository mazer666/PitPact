; Engine configuration file.
; PitPact — Pact & Pit: An Underworld of Terms and Terrors
;
; This file is the authoritative project root for the Godot 4 editor and
; the headless build/quality pipeline. It's safe to edit by hand for the
; M0/M1 bootstrap, but new settings should normally be set via the
; editor so the parameter list stays in sync with the engine version.
;
; See:
;   - AGENTS.md                  (contributor rules, engine conventions)
;   - docs/roadmap.md            (M0/M1 sequencing)
;   - docs/style-bible.md        (presentation/UX tone — drives input hints)
;
; Format:
;   [section]          ; section goes between []
;   param=value        ; assign values to parameters

config_version=5

[application]

config/name="PitPact"
config/description="Pact & Pit — An Underworld of Terms and Terrors"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

; This tempdata/ is created automatically on first run. We ignore it via
; .gitignore; the path is centralised here so the editor and headless
; tools agree on a location.
config/temp_folder="user://tmp"

[debug]

; Keep stdout free of editor noise during tests and benchmarks.
settings/stdout/print_fps=false
settings/stdout/print_gpu_profile=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

; PitPact is GDScript-first (see §16.1 of the requirements spec). The
; .NET runtime is intentionally disabled so contributors do not pull
; in a Mono toolchain by accident. Re-enable only after an ADR is filed.

[input]

; Touch-aware interactions are required from day one (§4.1 of
; docs/requirements.md). Every UI action has at least one keyboard /
; mouse binding AND at least one touch binding so the same scenes
; serve the desktop and the iPadOS port without a project.godot
; rewrite.
;
; The actions below are owned by src/ui/ and read by
; src/ui/isometric_camera.gd, src/ui/main.gd, the title screen,
; the pause menu, the diagnostics overlay, and the minimap.

ui_pan={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2,"pressed":true,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0,"canceled":false,"script":null)
, Object(InputEventScreenTouch,"index":-1,"position":Vector2(0, 0),"pressed":true,"double_tap":false,"script":null)
]
}
ui_zoom_in={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":true,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0,"canceled":false,"script":null)
, Object(InputEventScreenTouch,"index":0,"position":Vector2(0, 0),"pressed":true,"double_tap":false,"script":null)
]
}
ui_zoom_out={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":true,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0,"canceled":false,"script":null)
, Object(InputEventScreenTouch,"index":1,"position":Vector2(0, 0),"pressed":true,"double_tap":false,"script":null)
]
}
ui_paint={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1,"pressed":true,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_mask":0,"canceled":false,"script":null)
, Object(InputEventKey,"physical_keycode":0,"keycode":32,"unicode":0,"location":0,"echo":false,"pressed":true,"script":null)
, Object(InputEventScreenTouch,"index":2,"position":Vector2(0, 0),"pressed":true,"double_tap":false,"script":null)
]
}
ui_toggle_diagnostics={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194336,"keycode":4194336,"unicode":0,"location":0,"echo":false,"pressed":true,"script":null)
]
}
ui_toggle_minimap={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":77,"keycode":77,"unicode":109,"location":0,"echo":false,"pressed":true,"script":null)
]
}
ui_pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305,"keycode":4194305,"unicode":0,"location":0,"echo":false,"pressed":true,"script":null)
, Object(InputEventKey,"physical_keycode":80,"keycode":80,"unicode":112,"location":0,"echo":false,"pressed":true,"script":null)
]
}
ui_zoom_pinch={
"deadzone": 0.5,
"events": [Object(InputEventScreenDrag,"index":0,"position":Vector2(0, 0),"relative":Vector2(0, 0),"screen_drag":true,"script":null)
, Object(InputEventScreenDrag,"index":1,"position":Vector2(0, 0),"relative":Vector2(0, 0),"screen_drag":true,"script":null)
]
}
ui_pan_trackpad={
"deadzone": 0.5,
"events": [Object(InputEventMouseMotion,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"relative":Vector2(0, 0),"screen_relative":Vector2(0, 0),"pressure":0.0,"pen_inverted":false,"tilt":Vector2(0, 0),"script":null)
, Object(InputEventScreenDrag,"index":0,"position":Vector2(0, 0),"relative":Vector2(0, 0),"screen_drag":true,"script":null)
]
}
ui_focus_realm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"keycode":4194309,"unicode":0,"location":0,"echo":false,"pressed":true,"script":null)
]
}

[layer_names]

; Reserved for M1. The realm/sim/UI layer naming convention will be
; defined in the camera/UI shell PR.

[rendering]

; Forward+ is appropriate for the reference MacBook Air M5 (Metal) and
; desktop targets. The mobile renderer switch for iPadOS will be filed
; as an ADR before the iPadOS port milestone.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
